# Copy to .env.local for `pnpm dev`. Without SMTP_URL the sign-in link is written to the log;
# without ALLOWED_EMAILS everyone may sign in in development.
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-32-or-more-random-characters
